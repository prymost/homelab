{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "timezone": "America/Los_Angeles",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Homelab Dependency Dashboard",
  "labels": ["dependencies", "homelab"],
  "commitMessagePrefix": "chore(deps):",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "ignorePaths": [
    "clusters/homelab/flux-system/gotk-components.yaml"
  ],
  "flux": {
    "fileMatch": [
      "(^|/)clusters/.+\\.ya?ml$",
      "(^|/)sandbox/.+\\.ya?ml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "(^|/)clusters/.+\\.ya?ml$",
      "(^|/)sandbox/.+\\.ya?ml$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track K3s version pinned in Ansible role defaults and inventory group_vars",
      "fileMatch": [
        "(^|/)ansible/roles/k3s/defaults/main\\.ya?ml$",
        "(^|/)ansible/inventory/group_vars/all\\.ya?ml$"
      ],
      "matchStrings": [
        "k3s_version:\\s*[\"']?(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?\\+k3s[0-9]+)[\"']?"
      ],
      "autoReplaceStringTemplate": "k3s_version: \"{{{newValue}}}\"",
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>[a-z0-9.]+))?(?<compatibility>\\+k3s)(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group minor and patch updates for Helm releases together",
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Flux HelmReleases (non-major)"
    },
    {
      "description": "Group non-major updates and digest updates for general container images",
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "excludePackageNames": ["ghcr.io/home-assistant/home-assistant"],
      "groupName": "Kubernetes container images (non-major)"
    },
    {
      "description": "Keep Home Assistant updates isolated due to monthly breaking release cadence",
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant"],
      "groupName": "Home Assistant"
    },
    {
      "description": "Keep K3s updates isolated and clear",
      "matchPackageNames": ["k3s-io/k3s"],
      "groupName": "K3s engine"
    }
  ]
}
